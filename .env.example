# Copia este archivo como .env y ajusta los valores antes de levantar el proyecto
# En local puedes dejar los valores por defecto; en Coolify usa contraseñas seguras.

WP_PORT=8080
ADMINER_PORT=8081

MYSQL_DATABASE=esgrima_seac
MYSQL_USER=wp_user
MYSQL_PASSWORD=wp_password
MYSQL_ROOT_PASSWORD=rootpassword
